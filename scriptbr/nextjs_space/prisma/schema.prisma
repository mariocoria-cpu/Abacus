generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "/home/ubuntu/scriptbr/nextjs_space/node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plan          String    @default("free")
  stripeCustomerId    String?   @unique
  stripeSubscriptionId String?
  stripePriceId       String?
  subscriptionStatus  String?   @default("inactive")
  scriptsUsedThisMonth Int     @default(0)
  monthResetDate      DateTime @default(now())
  channelName         String?

  accounts      Account[]
  sessions      Session[]
  scripts       Script[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Script {
  id          String   @id @default(cuid())
  userId      String
  topic       String
  format      String
  tone        String
  audience    String
  duration    String
  channelName String?

  scriptContent    String  @db.Text
  thumbnailOptions String  @db.Text
  titleOptions     String  @db.Text
  description      String  @db.Text
  hashtags         String  @db.Text
  hookText         String  @db.Text

  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}
